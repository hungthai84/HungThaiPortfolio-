{
  "collections": {
    "website_system_state": {
      "description": "Stores the current status and summary results of each management module",
      "fields": {
        "moduleId": "string",
        "status": "string (NOT_CHECKED | CHECKED | CONFIRMED | COMPLETED | REVIEW_REQUIRED | ERROR)",
        "lastCheckedAt": "timestamp",
        "lastAppliedAt": "timestamp",
        "summary": "map",
        "proposedChanges": "array"
      }
    },
    "website_inventory": {
      "description": "Inventory of all objects recognized on the website",
      "fields": {
        "name": "string",
        "type": "string",
        "location": "string",
        "page": "string",
        "frequency": "number",
        "parentId": "string",
        "style": "map",
        "variant": "string",
        "status": "string"
      }
    },
    "website_settings": {
      "description": "Global and component-specific configurations",
      "fields": {
        "category": "string (GLOBAL | COMPONENT | CUSTOM | EXTERNAL)",
        "key": "string",
        "value": "any",
        "updatedAt": "timestamp"
      }
    },
    "website_history": {
      "description": "Audit logs for all applied changes",
      "fields": {
        "timestamp": "timestamp",
        "action": "string",
        "moduleId": "string",
        "before": "any",
        "after": "any",
        "userId": "string",
        "status": "string"
      }
    }
  }
}
