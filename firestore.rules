rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 3. User Validation Blueprint
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().size() == 3
        && data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.createdAt == request.time;
    }

    // 4. Users Collection
    match /users/{userId} {
      // Allow read only to the owner
      allow read: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      
      // Allow create if the user is creating their own profile
      allow create: if isSignedIn() 
                    && isValidId(userId) 
                    && userId == request.auth.uid 
                    && isValidUser(incoming());
                    
      // Allow update if the user is updating their own profile
      allow update: if isSignedIn() 
                    && isValidId(userId) 
                    && userId == request.auth.uid 
                    && incoming().diff(existing()).affectedKeys().hasOnly(['email'])
                    && incoming().email is string && incoming().email.size() <= 256;
                    
      allow delete: if false; // Users cannot delete their own profile directly

      // 5. User Preferences & Wallpapers Subcollection
      match /preferences/{prefId} {
        allow read, write: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidId(prefId);
      }
    }

    // 6. Shared Wallpapers & Configurations
    match /wallpapers/{wallpaperId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /system_config/{configId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
